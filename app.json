{
  "expo": {
    "name": "Riscado",
    "slug": "riscado",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "riscado",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#15131A",
    "android": {
      "package": "io.github.matheushrm.riscado",
      "adaptiveIcon": {
        "backgroundColor": "#15131A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#15131A",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      "expo-sqlite",
      "expo-secure-store",
      [
        "react-native-android-widget",
        {
          "fonts": [
            "./node_modules/@expo-google-fonts/bangers/400Regular/Bangers_400Regular.ttf",
            "./node_modules/@expo-google-fonts/kalam/700Bold/Kalam_700Bold.ttf"
          ],
          "widgets": [
            {
              "name": "Riscado",
              "label": "Riscado",
              "description": "Tarefas da lista atual. Aumenta o widget pra ganhar o botão de criar.",
              "minWidth": "110dp",
              "minHeight": "50dp",
              "targetCellWidth": 3,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "previewImage": "./assets/images/widget-preview.png",
              "updatePeriodMillis": 0
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
